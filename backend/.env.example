# Backend Server Port
PORT=5000

# MongoDB Connection URI (Local or MongoDB Atlas)
# Example for local MongoDB: mongodb://127.0.0.1:27017/smart_todo_db
# Example for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/smart_todo_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smart_todo_db

# Client URL (for CORS in production, optional - default allows local dev & Railway)
CLIENT_URL=http://localhost:5173
